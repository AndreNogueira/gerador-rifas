{
  "name": "gerador-rifas-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/comprimir-dist.mjs && node scripts/verificar-dist.mjs",
    "medir": "node scripts/medir-js.mjs",
    "tipos": "tsc --noEmit",
    "teste": "vitest run",
    "lint": "biome check .",
    "e2e": "playwright test",
    "videos": "node scripts/videos.mjs",
    "capturas": "node scripts/capturas.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource-variable/orbitron": "5.3.0",
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/alfa-slab-one": "5.3.0",
    "@fontsource/creepster": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "@fontsource/rye": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.7",
    "javascript-obfuscator": "5.10.0",
    "jsdom": "31.0.0",
    "sass": "1.108.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
